# Copiar como .env en la raíz del proyecto (no se sube a GitHub)
PORT=3000
NODE_ENV=development

# PostgreSQL (Prisma) · contenedor vet-postgres
DATABASE_URL=postgresql://espe_user:espe_password@localhost:5435/vet_db

# JWT
JWT_SECRET=cambia_este_secreto

# MongoDB (Mongoose) · contenedor vet-mongo
MONGODB_URI=mongodb://espe_user:espe_password@localhost:27018/vet_mongo?authSource=admin
