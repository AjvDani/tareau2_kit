// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  role          Role
  appointments  Appointment[]
  consultations Consultation[]
}

model Appointment {
  id          Int       @id @default(autoincrement())
  date        DateTime
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  timeBlock   TimeBlock @relation(fields: [timeBlockId], references: [id])
  timeBlockId Int
}

model TimeBlock {
  id           Int           @id @default(autoincrement())
  startTime    DateTime
  endTime      DateTime
  appointments Appointment[]
}

// Caso 7 · Veterinaria: la consulta es la entidad transaccional (1:N con User).
// treatmentId guarda el _id (ObjectId) del Tratamiento que vive en MongoDB: sin FK.
model Consultation {
  id          Int                @id @default(autoincrement())
  date        DateTime
  petName     String
  species     Species
  reason      String
  status      ConsultationStatus @default(ABIERTA)
  user        User               @relation(fields: [userId], references: [id])
  userId      Int
  treatmentId String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Una mascota del mismo dueño no tiene dos consultas a la misma hora.
  @@unique([userId, petName, date])
  // Lo pide el borrado protegido del catálogo: "¿alguna consulta usa este tratamiento?"
  @@index([treatmentId])
  // Lo pide el historial del dueño ordenado por fecha.
  @@index([userId, date])
}

enum Species {
  perro
  gato
  ave
  conejo
  reptil
}

enum ConsultationStatus {
  ABIERTA
  EN_TRATAMIENTO
  CERRADA
}

enum Role {
  ADMIN
  USER
}
