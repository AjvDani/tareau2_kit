            "exec": [
              "const suffix = String(Date.now()).slice(-6) + String(Math.floor(Math.random() * 90 + 10));",
              "pm.collectionVariables.set(\"suffix\", suffix);",
              "pm.collectionVariables.set(\"email1\", `duenio1_${suffix}@vet.test`);",
              "pm.collectionVariables.set(\"email2\", `duenio2_${suffix}@vet.test`);",
              "pm.collectionVariables.set(\"codeA\", `trt-${suffix.slice(-6)}`);",
              "pm.collectionVariables.set(\"codeB\", `TRT-${String(Number(suffix.slice(-6)) + 1).padStart(6, \"0\")}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));"
            ]
